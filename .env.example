# Production database connection (Railway/Neon Postgres).
# When unset, the app runs on local-first file-backed PGlite.
DATABASE_URL=

# Optional: override the local PGlite data directory (dev only).
# PGLITE_PATH=./.pglite

# Session cookie signing secret (required in production). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Email (magic-link + nudges). When both are set, Resend is used; else links
# are logged server-side. FROM must be on a domain verified in your Resend
# workspace (use a dedicated, isolated key — see BLOCKED.md).
RESEND_API_KEY=
EMAIL_FROM=Roodle <hi@your-verified-domain>

# Absolute base URL used to build magic links (prod). e.g. the Railway URL.
# APP_URL=https://roodle-web-production.up.railway.app
